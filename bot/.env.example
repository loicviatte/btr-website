# Only for running the bot by hand. On the server, .env is written by the GitHub workflow
# .github/workflows/bot-deploy.yml from the repo secrets: do not edit it there.

# Telegram: token from @BotFather. Leave TELEGRAM_CHAT_ID empty the first time,
# send /start to the bot, it answers with your id, paste it here and restart.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# YouTube
YOUTUBE_CHANNEL_ID=UCPTfscPkr0Div6di8S3IX9w
# Same values as the website's GitHub secrets (Google app "BTR Website", scope youtube.force-ssl).
# Get them again any time on your Mac with: python3 tools/auto/get_token.py <client_secret.json>  (in btr-website)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Alternative: a token file made with  python -m btrbot.auth
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
# Optional but recommended on a server: cookies.txt exported from a logged-in YouTube session
YTDLP_COOKIES=secrets/youtube_cookies.txt

# Every how many minutes to look for new unlisted videos
POLL_MINUTES=15
